{
  "expo": {
    "name": "Intercourier Corvo",
    "slug": "intercourier-corvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intercourier",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intercourier.corvo",
      "infoPlist": {
        "NSCameraUsageDescription": "Ler códigos de barras e tirar fotos",
        "NSPhotoLibraryUsageDescription": "Selecionar fotos e assinaturas"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.intercourier.corvo",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a365d"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos e assinaturas",
          "cameraPermission": "Tirar fotos das entregas"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ler códigos de barras das etiquetas"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
